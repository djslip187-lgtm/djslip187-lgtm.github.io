<svg viewBox="0 0 1217 817" xmlns="http://www.w3.org/2000/svg">
<defs>
  <!-- Halftone dot pattern for billboard -->
  <pattern id="dots" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
    <circle cx="11" cy="11" r="4.5" fill="#9dc800"/>
  </pattern>
  <!-- Fade mask: dots appear only on right side of billboard -->
  <linearGradient id="dotFade" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0%"   stop-color="white" stop-opacity="0"/>
    <stop offset="35%"  stop-color="white" stop-opacity="0"/>
    <stop offset="65%"  stop-color="white" stop-opacity="0.35"/>
    <stop offset="100%" stop-color="white" stop-opacity="0.65"/>
  </linearGradient>
  <mask id="dotMask">
    <rect x="180" y="12" width="762" height="182" fill="url(#dotFade)"/>
  </mask>

  <!-- Soft drop shadow -->
  <filter id="sh" x="-8%" y="-8%" width="120%" height="130%">
    <feDropShadow dx="0" dy="6" stdDeviation="14" flood-color="#000" flood-opacity="0.55"/>
  </filter>
  <filter id="sh-sm" x="-8%" y="-8%" width="120%" height="130%">
    <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.45"/>
  </filter>
  <filter id="sh-xs" x="-10%" y="-10%" width="130%" height="140%">
    <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#000" flood-opacity="0.4"/>
  </filter>

  <!-- Gradient for grass ground shadow -->
  <radialGradient id="grassShadow" cx="50%" cy="50%" r="50%">
    <stop offset="0%"   stop-color="#000" stop-opacity="0.4"/>
    <stop offset="100%" stop-color="#000" stop-opacity="0"/>
  </radialGradient>
</defs>


<!-- ══════════════════════════════════════════
     BILLBOARD
══════════════════════════════════════════ -->
<g filter="url(#sh)">
  <!-- Main face -->
  <rect x="180" y="12" width="762" height="182" rx="5" fill="#0e0e0e"/>
  <!-- Halftone overlay -->
  <rect x="180" y="12" width="762" height="182" rx="5" fill="url(#dots)" mask="url(#dotMask)"/>
  <!-- Left green accent bar -->
  <rect x="180" y="12" width="7" height="182" rx="2" fill="#9dc800"/>
  <!-- Bottom trim line -->
  <rect x="187" y="186" width="755" height="4" rx="1" fill="#9dc800" opacity="0.4"/>
  <!-- Subtle border -->
  <rect x="180" y="12" width="762" height="182" rx="5" fill="none" stroke="#252525" stroke-width="2"/>

  <!-- CUSTOM label -->
  <text x="220" y="60" font-family="'Arial Black','Impact',sans-serif" font-size="17" font-weight="900" fill="#9dc800" letter-spacing="5">CUSTOM</text>
  <!-- BILLBOARD DESIGN -->
  <text x="216" y="118" font-family="'Arial Black','Impact',sans-serif" font-size="58" font-weight="900" fill="#f5f5f2" letter-spacing="-1">BILLBOARD</text>
  <text x="216" y="168" font-family="'Arial Black','Impact',sans-serif" font-size="58" font-weight="900" fill="#f5f5f2" letter-spacing="-1">DESIGN</text>
  <!-- Services italic -->
  <text x="570" y="168" font-family="Georgia,'Times New Roman',serif" font-size="36" font-style="italic" fill="#9dc800">Services</text>
  <!-- URL -->
  <text x="926" y="191" font-family="'Courier New',monospace" font-size="11" fill="#444" text-anchor="end">www.fantasticsigns.com</text>
</g>

<!-- Billboard support poles -->
<rect x="328" y="194" width="10" height="155" rx="2" fill="#1c1c1c"/>
<rect x="788" y="194" width="10" height="155" rx="2" fill="#1c1c1c"/>
<!-- Cross brace -->
<line x1="333" y1="270" x2="793" y2="270" stroke="#181818" stroke-width="4"/>


<!-- ══════════════════════════════════════════
     RETRACTABLE BANNER  (far right)
══════════════════════════════════════════ -->
<g filter="url(#sh-sm)">
  <!-- Banner body -->
  <rect x="988" y="158" width="165" height="458" rx="5" fill="#0c0c0c"/>
  <!-- Top green stripe -->
  <rect x="988" y="158" width="165" height="16" rx="3" fill="#9dc800"/>
  <!-- Bottom green stripe -->
  <rect x="988" y="600" width="165" height="16" rx="2" fill="#84aa3f"/>
  <!-- Border -->
  <rect x="988" y="158" width="165" height="458" rx="5" fill="none" stroke="#222" stroke-width="1.5"/>

  <!-- Accent divider line -->
  <rect x="1005" y="192" width="131" height="2.5" fill="#9dc800"/>

  <!-- RETRACTABLE -->
  <text x="1070" y="242" font-family="'Arial Black','Impact',sans-serif" font-size="19" font-weight="900" fill="#f5f5f2" text-anchor="middle" letter-spacing="1">RETRACTABLE</text>
  <!-- BANNERS large -->
  <text x="1070" y="294" font-family="'Arial Black','Impact',sans-serif" font-size="42" font-weight="900" fill="#9dc800" text-anchor="middle" letter-spacing="-0.5">BANNERS</text>
  <!-- Divider -->
  <rect x="1005" y="308" width="131" height="1.5" fill="#252525"/>
  <!-- FOR ANY TYPE OF -->
  <text x="1070" y="345" font-family="Arial,sans-serif" font-size="13" fill="#999" text-anchor="middle" letter-spacing="1">FOR ANY TYPE OF</text>
  <!-- BUSINESS -->
  <text x="1070" y="378" font-family="'Arial Black','Impact',sans-serif" font-size="30" font-weight="900" fill="#f5f5f2" text-anchor="middle">BUSINESS</text>

  <!-- Body copy lines -->
  <rect x="1012" y="398" width="117" height="1" fill="#222"/>
  <text x="1070" y="420" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">LIGHTWEIGHT · PORTABLE</text>
  <text x="1070" y="437" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">QUICK SETUP · FULL COLOR</text>
  <rect x="1012" y="450" width="117" height="1" fill="#222"/>

  <!-- Logo block -->
  <rect x="1016" y="510" width="109" height="65" rx="4" fill="#9dc800" opacity="0.08"/>
  <rect x="1016" y="510" width="109" height="65" rx="4" fill="none" stroke="#9dc800" stroke-opacity="0.2" stroke-width="1"/>
  <text x="1070" y="543" font-family="Georgia,serif" font-size="16" font-style="italic" fill="#9dc800" text-anchor="middle">SignsRGreat</text>
  <text x="1070" y="563" font-family="'Courier New',monospace" font-size="8" fill="#444" text-anchor="middle">www.fantasticsigns.com</text>
</g>

<!-- Retractable banner pole -->
<rect x="1067" y="616" width="7" height="68" rx="2" fill="#1e1e1e"/>
<!-- Base housing -->
<rect x="1008" y="678" width="125" height="18" rx="5" fill="#181818" stroke="#252525" stroke-width="1.5"/>
<!-- Base feet -->
<rect x="1000" y="692" width="42" height="8" rx="2" fill="#151515"/>
<rect x="1099" y="692" width="42" height="8" rx="2" fill="#151515"/>


<!-- ══════════════════════════════════════════
     LEFT CLUSTER — VERTICAL BANNER (behind)
══════════════════════════════════════════ -->
<g filter="url(#sh-xs)" transform="rotate(-4, 175, 460)">
  <rect x="88" y="252" width="175" height="340" rx="4" fill="#0b0b0b" stroke="#202020" stroke-width="1.5"/>
  <rect x="88" y="252" width="175" height="12" rx="2" fill="#84aa3f"/>
  <text x="175" y="306" font-family="'Arial Black','Impact',sans-serif" font-size="13" font-weight="900" fill="#9dc800" text-anchor="middle" letter-spacing="3">CUSTOM</text>
  <text x="175" y="338" font-family="'Arial Black','Impact',sans-serif" font-size="28" font-weight="900" fill="#f5f5f2" text-anchor="middle">VERTICAL</text>
  <text x="175" y="368" font-family="'Arial Black','Impact',sans-serif" font-size="28" font-weight="900" fill="#f5f5f2" text-anchor="middle">BANNER</text>
  <text x="175" y="396" font-family="'Arial Black','Impact',sans-serif" font-size="22" font-weight="900" fill="#9dc800" text-anchor="middle">DESIGN</text>
  <rect x="104" y="412" width="143" height="1" fill="#252525"/>
  <text x="175" y="436" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">FULL-COLOR PRINT</text>
  <text x="175" y="452" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">ANY SIZE · FAST TURNAROUND</text>
</g>


<!-- ══════════════════════════════════════════
     LEFT CLUSTER — MAIN YARD SIGN (front)
══════════════════════════════════════════ -->
<g filter="url(#sh-sm)">
  <!-- Sign face -->
  <rect x="95" y="330" width="310" height="238" rx="5" fill="#0d0d0d"/>
  <!-- Green top bar -->
  <rect x="95" y="330" width="310" height="14" rx="3" fill="#9dc800"/>
  <!-- Green bottom bar -->
  <rect x="95" y="554" width="310" height="10" rx="2" fill="#84aa3f" opacity="0.6"/>
  <!-- Border -->
  <rect x="95" y="330" width="310" height="238" rx="5" fill="none" stroke="#222" stroke-width="2"/>
  <!-- Inner border accent -->
  <rect x="106" y="356" width="288" height="210" rx="3" fill="none" stroke="#1c1c1c" stroke-width="1"/>

  <!-- CUSTOM -->
  <text x="250" y="398" font-family="'Arial Black','Impact',sans-serif" font-size="16" font-weight="900" fill="#9dc800" text-anchor="middle" letter-spacing="4">CUSTOM</text>
  <!-- YARD SIGN -->
  <text x="250" y="446" font-family="'Arial Black','Impact',sans-serif" font-size="44" font-weight="900" fill="#f5f5f2" text-anchor="middle" letter-spacing="-0.5">YARD SIGN</text>
  <!-- DESIGN -->
  <text x="250" y="492" font-family="'Arial Black','Impact',sans-serif" font-size="44" font-weight="900" fill="#f5f5f2" text-anchor="middle" letter-spacing="-0.5">DESIGN</text>
  <!-- URL bar -->
  <rect x="106" y="508" width="288" height="1.5" fill="#252525"/>
  <text x="250" y="532" font-family="'Courier New',monospace" font-size="11" fill="#484848" text-anchor="middle">www.fantasticsigns.com</text>
  <!-- Small logo -->
  <text x="250" y="552" font-family="Georgia,serif" font-size="11" font-style="italic" fill="#9dc800" text-anchor="middle">SignsRGreat</text>
</g>
<!-- Yard sign stakes -->
<rect x="176" y="568" width="9" height="130" rx="2" fill="#242424"/>
<rect x="315" y="568" width="9" height="130" rx="2" fill="#242424"/>


<!-- ══════════════════════════════════════════
     CENTER — 4-FRAME / A-FRAME SIGN
══════════════════════════════════════════ -->
<g filter="url(#sh-sm)">
  <!-- Left panel (slight angle) -->
  <polygon points="476,295 640,295 630,658 466,658" fill="#0d0d0d"/>
  <polygon points="476,295 640,295 640,312 476,312" fill="#9dc800"/>
  <polygon points="476,295 640,295 630,658 466,658" fill="none" stroke="#222" stroke-width="1.5"/>

  <!-- Right panel -->
  <polygon points="646,295 808,295 818,658 656,658" fill="#111"/>
  <polygon points="646,295 808,295 808,312" fill="#84aa3f"/>
  <polygon points="646,295 808,295 818,658 656,658" fill="none" stroke="#222" stroke-width="1.5"/>

  <!-- Spine / hinge -->
  <rect x="638" y="293" width="8" height="367" fill="#1a1a1a"/>

  <!-- Left panel content -->
  <text x="555" y="358" font-family="'Arial Black','Impact',sans-serif" font-size="13" font-weight="900" fill="#9dc800" text-anchor="middle" letter-spacing="2">4-FRAME SIGN</text>
  <text x="555" y="400" font-family="'Arial Black','Impact',sans-serif" font-size="36" font-weight="900" fill="#f5f5f2" text-anchor="middle">DESIGN</text>
  <text x="555" y="438" font-family="'Arial Black','Impact',sans-serif" font-size="36" font-weight="900" fill="#f5f5f2" text-anchor="middle">SERVICES</text>
  <rect x="488" y="455" width="140" height="1.5" fill="#252525"/>
  <text x="555" y="479" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">SIDEWALK · OUTDOOR</text>
  <text x="555" y="496" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">PROMOTIONAL DISPLAY</text>
  <text x="555" y="513" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">LIGHTWEIGHT ALUMINUM</text>

  <!-- Right panel content -->
  <rect x="660" y="338" width="134" height="80" rx="4" fill="#9dc800" opacity="0.07"/>
  <rect x="660" y="338" width="134" height="80" rx="4" fill="none" stroke="#9dc800" stroke-opacity="0.15" stroke-width="1"/>
  <text x="727" y="372" font-family="Georgia,serif" font-size="18" font-style="italic" fill="#9dc800" text-anchor="middle">Fantastic</text>
  <text x="727" y="396" font-family="'Arial Black',sans-serif" font-size="18" font-weight="900" fill="#f5f5f2" text-anchor="middle">SIGNS</text>

  <rect x="662" y="432" width="132" height="1" fill="#222"/>
  <text x="727" y="457" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">FULL COLOR GRAPHICS</text>
  <text x="727" y="473" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">WEATHER RESISTANT</text>
  <text x="727" y="489" font-family="Arial,sans-serif" font-size="10" fill="#555" text-anchor="middle">REUSABLE INSERTS</text>

  <!-- Base feet -->
  <rect x="460" y="650" width="185" height="12" rx="4" fill="#181818" stroke="#252525" stroke-width="1.2"/>
  <rect x="650" y="650" width="175" height="12" rx="4" fill="#181818" stroke="#252525" stroke-width="1.2"/>
  <rect x="452" y="660" width="50" height="8" rx="2" fill="#141414"/>
  <rect x="578" y="660" width="50" height="8" rx="2" fill="#141414"/>
  <rect x="642" y="660" width="50" height="8" rx="2" fill="#141414"/>
  <rect x="772" y="660" width="50" height="8" rx="2" fill="#141414"/>
</g>


